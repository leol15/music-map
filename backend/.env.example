PORT=3001

# Set to true to skip LLM calls and return hardcoded songs (useful for debugging)
MOCK_RECOMMENDATIONS=false

# Spotify (dedicated app account)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REFRESH_TOKEN=your_spotify_refresh_token

# CORS — comma-separated list of allowed origins
# e.g. https://yourusername.github.io,http://localhost:5173
ALLOWED_ORIGINS=https://yourusername.github.io,http://localhost:5173

# LLM
LLM_PROVIDER=anthropic      # anthropic | google | gemini-cli
MUSIC_PROVIDER=spotify      # spotify
ANTHROPIC_MODEL=claude-opus-4-6  # optional override
RECOMMENDATION_COUNT=10          # optional override

# Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key

# Google GenAI provider (LLM_PROVIDER=google)
GOOGLE_API_KEY=your_google_api_key
GOOGLE_MODEL=gemini-2.0-flash      # optional override

# Gemini CLI provider (LLM_PROVIDER=gemini-cli)
GEMINI_CLI_CMD=gemini            # path to CLI binary if not on PATH
GEMINI_CLI_TIMEOUT_MS=30000      # optional, default 30s
